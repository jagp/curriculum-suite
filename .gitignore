# Session tooling state (per-machine, never shared)
.remember/
.claude/.omnilog/
.claude/settings.local.json
.claude/worktrees/

# Drop-in folder for run inputs: everything inside stays local except its README.
# (`inputs/*`, not `inputs/`, so the README can be re-included.)
/inputs/*
!/inputs/README.md

# Coordinator working notes (local; CLAUDE.md points sessions at them)
/HANDOFF*.md
/decisions.md

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
