{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "h0-inputs.schema.json",
  "title": "inputs.json",
  "description": "Everything known about one client, in one file. Client data reaches a skill only through this file. Weekly goals and criteria carry ids so outputs can be checked against them. A glossary value that starts with UNRESOLVED or PROVISIONAL is not yet a definition.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "client", "goal", "weekly_goals", "criteria", "constraints", "participant_profile", "glossary"],
  "properties": {
    "schema": { "const": "h0-inputs/1" },
    "client": { "$ref": "common.schema.json#/$defs/text" },
    "goal": { "$ref": "common.schema.json#/$defs/text" },
    "weekly_goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "goal"],
        "properties": {
          "id": { "type": "string", "pattern": "^W[0-9]+$" },
          "goal": { "$ref": "common.schema.json#/$defs/text" }
        }
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "check", "pass_if"],
        "properties": {
          "id": { "type": "string", "pattern": "^C[0-9]+$" },
          "check": { "$ref": "common.schema.json#/$defs/text" },
          "pass_if": { "$ref": "common.schema.json#/$defs/text" }
        }
      }
    },
    "constraints": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/text" } },
    "participant_profile": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "common.schema.json#/$defs/text" }
    },
    "glossary": {
      "type": "object",
      "additionalProperties": { "$ref": "common.schema.json#/$defs/text" }
    },
    "presenter_owned": {
      "description": "Work the presenter owns. It is context, never something participants must do.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "note"],
        "properties": {
          "id": { "type": "string", "pattern": "^P[0-9]+$" },
          "note": { "$ref": "common.schema.json#/$defs/text" }
        }
      }
    }
  }
}
